      "pattern": "\\brequestSiriAuthorization\\b",
      "keys": ["NSSiriUsageDescription"]
    },
    {
      "label": "Bonjour browsing",
      "pattern": "\\bNWBrowser\\b|\\bNetServiceBrowser\\b|\\bNSNetServiceBrowser\\b",
      "keys": ["NSLocalNetworkUsageDescription"]
    }
  ],
