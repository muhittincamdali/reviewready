  "accounts": {
    "creation": [
      {
        "label": "a createUser(withEmail:) call",
        "pattern": "\\bcreateUser\\s*\\(\\s*withEmail\\b"
      },
      {
        "label": "a createUserWithEmailAndPassword call",
        "pattern": "\\bcreateUserWithEmailAndPassword\\b"
      },
      { "label": "an auth.signUp call", "pattern": "\\.\\s*auth\\s*\\.\\s*signUp\\s*\\(" },
      {
        "label": "an Amplify.Auth.signUp call",
        "pattern": "\\bAmplify\\s*\\.\\s*Auth\\s*\\.\\s*signUp\\b"
      },
      {
        "label": "a Clerk sign-up call",
        "pattern": "\\buseSignUp\\s*\\(|\\bsignUp\\s*\\.\\s*create\\s*\\("
      }
    ],
    "creationText": "[\"'`](?:Create (?:an |your )?[Aa]ccount|Sign [Uu]p|SIGN UP|Register an account)[\"'`]",
    "deletion": [
      {
        "label": "a deleteAccount or deleteUser call",
        "pattern": "\\b(?:deleteAccount|deleteUser|deleteMyAccount|removeAccount|delete_account|delete_user)\\b"
      },
      {
        "label": "a user.delete() call",
        "pattern": "\\b(?:currentUser|user)\\s*[?!]?\\s*\\.\\s*delete\\s*\\("
      }
    ],
    "deletionText": "\\b(?:[Dd]elete|[Dd]eleting|[Rr]emove|[Cc]lose)[-_ ]?(?:[Mm]y[-_ ]|[Yy]our[-_ ]|[Tt]he[-_ ])?[Aa]ccount\\b|\\bDELETE ACCOUNT\\b"
  }
