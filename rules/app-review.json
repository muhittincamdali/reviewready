{
  "$schema": "./schema.json",
  "ruleSet": "app-review",
  "dataVersion": "2026.10.28",
  "read": "2026-10-28",
  "requirements": {
    "xcode": {
      "minimum": "26",
      "since": "2026-04-28",
      "text": "Apps uploaded to App Store Connect must be built with Xcode 26 or later using the iOS 26 SDK."
    },
    "deploymentTarget": {
      "minimum": "13.0",
      "since": "2026-09-09",
      "text": "iOS and iPadOS apps uploaded to App Store Connect must target iOS 13 or later."
    }
  },
  "rules": [
    {
      "id": "RVW101",
      "severity": "error",
      "title": "Purpose string missing",
      "summary": "The app's code or a package it ships uses a protected resource, and the Info.plist has no purpose string for it. App Review rejects apps that contain code accessing a protected resource without one, including code in libraries the app does not call, and the app can crash when it asks for access.",
      "sources": [
        {
          "title": "Apple: Requesting access to protected resources",
          "url": "https://developer.apple.com/documentation/uikit/requesting-access-to-protected-resources"
        },
        {
          "title": "App Review Guidelines 5.1.1(ii) Permission",
          "url": "https://developer.apple.com/app-store/review/guidelines/#data-collection-and-storage"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Add the key to Info.plist",
          "steps": [
            "Add the key to the target's Info.plist with one sentence that says what the app does with the data, for example: <key>NSCameraUsageDescription</key><string>Scan the barcode on a receipt to add it to your expenses.</string>",
            "If the app never uses this feature, remove the code or the package that uses it instead."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "build-setting": {
          "title": "Add the key in Signing & Capabilities or as a build setting",
          "steps": [
            "In Xcode, select the target, open Info, and add the key with a sentence that says what the app does with the data. Xcode stores it as the INFOPLIST_KEY_<key> build setting.",
            "If the app never uses this feature, remove the code or the package that uses it instead."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "expo-config": {
          "title": "Set the text in app.json",
          "steps": [
            "Set the key under expo.ios.infoPlist in app.json, or pass the text to the package's config plugin option, with a sentence that says what the app does with the data.",
            "Run npx expo prebuild --clean (or the next EAS Build) so the native Info.plist gets it."
          ],
          "guide": "docs/guides/purpose-strings.md"
        }
      }
    },
    {
      "id": "RVW102",
      "severity": "warning",
      "title": "Purpose string missing for a package feature",
      "summary": "A package the app ships needs a purpose string for one of its features (for example recording video with the camera picker). If the app uses that feature, the key is required; if it does not, nothing needs to change.",
      "sources": [
        {
          "title": "Apple: Requesting access to protected resources",
          "url": "https://developer.apple.com/documentation/uikit/requesting-access-to-protected-resources"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Add the key if the app uses the feature",
          "steps": [
            "If the app uses the feature the finding names, add the key to Info.plist with a sentence that says what the app does with the data.",
            "If it does not, leave the Info.plist as it is and turn the finding off with --ignore RVW102."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "expo-config": {
          "title": "Set the text in app.json if the app uses the feature",
          "steps": [
            "If the app uses the feature, set the key under expo.ios.infoPlist in app.json or through the package's config plugin option.",
            "If it does not, leave app.json as it is and turn the finding off with --ignore RVW102."
          ],
          "guide": "docs/guides/purpose-strings.md"
        }
      }
    },
    {
      "id": "RVW103",
      "severity": "error",
      "title": "Purpose string not valid",
      "summary": "Apple's requirements for a purpose string: it is not blank or only whitespace, it is shorter than 4,000 bytes, and it has the type the key requires (a string).",
      "sources": [
        {
          "title": "Apple: Adhere to the requirements for purpose strings",
          "url": "https://developer.apple.com/documentation/uikit/requesting-access-to-protected-resources"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Write a one-sentence string",
          "steps": [
            "Make the value a <string> of one complete sentence that says what the app does with the data, well under 4,000 bytes."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "build-setting": {
          "title": "Write a one-sentence string",
          "steps": [
            "Set the INFOPLIST_KEY_<key> build setting (target > Info in Xcode) to one complete sentence that says what the app does with the data."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "expo-config": {
          "title": "Write a one-sentence string",
          "steps": [
            "Set the key in expo.ios.infoPlist to a string of one complete sentence that says what the app does with the data."
          ],
          "guide": "docs/guides/purpose-strings.md"
        }
      }
    },
    {
      "id": "RVW104",
      "severity": "warning",
      "title": "Purpose string is placeholder or default text",
      "summary": "The purpose string is a placeholder, a sample from a package's README, or the default text a config plugin writes when the app gives none. Apple asks for a description that is accurate, meaningful and specific about why the app needs access, and guideline 5.1.1(ii) asks purpose strings to clearly and completely describe the use of the data.",
      "sources": [
        {
          "title": "Apple: Adhere to the requirements for purpose strings",
          "url": "https://developer.apple.com/documentation/uikit/requesting-access-to-protected-resources"
        },
        {
          "title": "App Review Guidelines 5.1.1(ii) Permission",
          "url": "https://developer.apple.com/app-store/review/guidelines/#data-collection-and-storage"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Say why the app needs access",
          "steps": [
            "Replace the text with one sentence that names what the app does with the data, for example \"Take a photo of your meal to log it\" rather than \"needs camera access\"."
          ],
          "guide": "docs/guides/purpose-strings.md"
        },
        "expo-config": {
          "title": "Pass your own text to the config plugin",
          "steps": [
            "Add the plugin to expo.plugins with its permission option, for example [\"expo-camera\", { \"cameraPermission\": \"Scan a receipt to add it to your expenses.\" }], or set the key under expo.ios.infoPlist.",
            "Set the option to false instead if the app never uses that permission: the plugin then leaves the key out."
          ],
          "guide": "docs/guides/purpose-strings.md"
        }
      }
    },
    {
      "id": "RVW201",
      "severity": "warning",
      "title": "Export compliance not declared",
      "summary": "The Info.plist has no ITSAppUsesNonExemptEncryption key, so App Store Connect walks you through the export compliance questions every time you upload a new version, and the build waits for the answer before it can go to TestFlight or review.",
      "sources": [
        {
          "title": "Apple: ITSAppUsesNonExemptEncryption",
          "url": "https://developer.apple.com/documentation/bundleresources/information-property-list/itsappusesnonexemptencryption"
        },
        {
          "title": "Apple: Complying with Encryption Export Regulations",
          "url": "https://developer.apple.com/documentation/security/complying-with-encryption-export-regulations"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Declare the app's encryption",
          "steps": [
            "If the app (with its libraries) uses no encryption, or only the encryption built into the operating system such as HTTPS through URLSession, add <key>ITSAppUsesNonExemptEncryption</key><false/>.",
            "If it uses non-exempt encryption, set it to <true/> and add ITSEncryptionExportComplianceCode with the code Apple gives you after reviewing your documentation."
          ],
          "guide": "docs/guides/export-compliance.md"
        },
        "build-setting": {
          "title": "Declare the app's encryption",
          "steps": [
            "Set the INFOPLIST_KEY_ITSAppUsesNonExemptEncryption build setting to NO if the app uses no encryption or only exempt encryption such as HTTPS, or to YES with ITSEncryptionExportComplianceCode otherwise."
          ],
          "guide": "docs/guides/export-compliance.md"
        },
        "expo-config": {
          "title": "Declare the app's encryption in app.json",
          "steps": [
            "Set expo.ios.config.usesNonExemptEncryption to false if the app uses no encryption or only exempt encryption such as HTTPS, or to true and follow Apple's documentation otherwise."
          ],
          "guide": "docs/guides/export-compliance.md"
        }
      }
    },
    {
      "id": "RVW301",
      "severity": "warning",
      "title": "Account creation without account deletion",
      "summary": "The app's code creates accounts, and reviewready found no way to delete one in the code or the app's strings. Guideline 5.1.1(v): if an app supports account creation, it must also offer account deletion within the app. This is a heuristic: it reads calls and words, not screens.",
      "sources": [
        {
          "title": "App Review Guidelines 5.1.1(v) Account Sign-In",
          "url": "https://developer.apple.com/app-store/review/guidelines/#data-collection-and-storage"
        },
        {
          "title": "Apple: Offering account deletion in your app",
          "url": "https://developer.apple.com/support/offering-account-deletion-in-your-app/"
        }
      ],
      "fixes": {
        "code": {
          "title": "Let people delete their account in the app",
          "steps": [
            "Add a Delete account action that is easy to find, usually in the account settings, and that deletes the account record with its personal data, not only deactivates it.",
            "If deletion finishes on a website, link straight to that page. With Sign in with Apple, also revoke the user's tokens.",
            "If the app already has it under words reviewready does not know, turn the finding off with --ignore RVW301."
          ],
          "guide": "docs/guides/accounts-and-sign-in.md"
        }
      }
    },
    {
      "id": "RVW401",
      "severity": "warning",
      "title": "Third-party login without an equivalent option",
      "summary": "The app ships a third-party or social login service and reviewready found no Sign in with Apple. Guideline 4.8: an app that uses such a service for the user's primary account must also offer an equivalent login service that limits data collection to name and email, lets users keep their email private, and does not collect interactions for advertising without consent. Sign in with Apple is one such service. The guideline lists exceptions (own account system only, education or enterprise accounts, government ID, clients for a specific third-party service).",
      "sources": [
        {
          "title": "App Review Guidelines 4.8 Login Services",
          "url": "https://developer.apple.com/app-store/review/guidelines/#login-services"
        },
        {
          "title": "Apple: Sign in with Apple",
          "url": "https://developer.apple.com/sign-in-with-apple/"
        }
      ],
      "fixes": {
        "code": {
          "title": "Offer Sign in with Apple next to the other login",
          "steps": [
            "Add Sign in with Apple (AuthenticationServices on iOS, sign_in_with_apple on Flutter, expo-apple-authentication or @invertase/react-native-apple-authentication on React Native) and the Sign in with Apple capability.",
            "If the app falls under one of the exceptions of guideline 4.8, or offers another login service with the listed features, turn the finding off with --ignore RVW401."
          ],
          "guide": "docs/guides/accounts-and-sign-in.md"
        }
      }
    },
    {
      "id": "RVW501",
      "severity": "error",
      "title": "No App Store icon",
      "summary": "The target's app icon set has no 1024 × 1024 App Store image, or there is no icon set with the name the target builds. Xcode generates every size from a single 1024 × 1024 image, and the asset catalog's 1024 × 1024 image is the App Store icon.",
      "sources": [
        {
          "title": "Apple: Configuring your app icon",
          "url": "https://developer.apple.com/documentation/xcode/configuring-your-app-icon"
        },
        {
          "title": "Apple: Asset Catalog Format Reference, App Icon Type",
          "url": "https://developer.apple.com/library/archive/documentation/Xcode/Reference/xcode_ref-Asset_Catalog_Format/AppIconType.html"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Add the 1024 × 1024 image",
          "steps": [
            "Open the asset catalog in Xcode, select the app icon and drop a 1024 × 1024 PNG into the App Store (or single-size iOS) slot, or add an Icon Composer .icon file with the name the target builds (ASSETCATALOG_COMPILER_APPICON_NAME)."
          ],
          "guide": "docs/guides/app-icon.md"
        },
        "expo-config": {
          "title": "Set the icon in app.json",
          "steps": ["Set expo.icon (or expo.ios.icon) to a 1024 × 1024 PNG in the project."],
          "guide": "docs/guides/app-icon.md"
        }
      }
    },
    {
      "id": "RVW502",
      "severity": "error",
      "title": "App Store icon is not 1024 × 1024",
      "summary": "The App Store image of the icon set is not 1024 × 1024 pixels. Xcode 27.1's asset catalog compiler warns that the image \"should be 1024x1024\" and, with no other image, fails with \"did not have any applicable content\".",
      "sources": [
        {
          "title": "Apple: Configuring your app icon",
          "url": "https://developer.apple.com/documentation/xcode/configuring-your-app-icon"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Export the icon at 1024 × 1024",
          "steps": [
            "Export the icon as a 1024 × 1024 PNG and put it in the App Store slot of the icon set."
          ],
          "guide": "docs/guides/app-icon.md"
        },
        "expo-config": {
          "title": "Use a 1024 × 1024 PNG",
          "steps": [
            "Point expo.icon (or expo.ios.icon) at a 1024 × 1024 PNG; Expo recommends that size."
          ],
          "guide": "docs/guides/app-icon.md"
        }
      }
    },
    {
      "id": "RVW503",
      "severity": "error",
      "title": "App Store icon has an alpha channel",
      "summary": "The App Store image of the icon set has an alpha channel or a transparent colour. App Store Connect's upload check refuses it with \"The large app icon in the asset catalog can't be transparent or contain an alpha channel\" (asset validation 90717). Xcode 27.1's asset catalog compiler does not warn about it.",
      "sources": [
        {
          "title": "Apple Developer Forums: Icon composer icon contains alpha channel upload error (the 90717 message, with a DTS engineer)",
          "url": "https://developer.apple.com/forums/thread/795411"
        },
        {
          "title": "Apple: Human Interface Guidelines, App icons",
          "url": "https://developer.apple.com/design/human-interface-guidelines/app-icons"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Export the icon without transparency",
          "steps": [
            "Export the 1024 × 1024 icon as an opaque PNG: give it a solid background and turn off \"Transparency\" or \"Alpha\" in the export settings (in Preview: File > Export, untick Alpha).",
            "Check it with: sips -g hasAlpha path/to/icon.png (it should print hasAlpha: no)."
          ],
          "guide": "docs/guides/app-icon.md"
        }
      }
    },
    {
      "id": "RVW601",
      "severity": "error",
      "title": "Xcode older than App Store Connect accepts",
      "summary": "A build file pins an Xcode version older than Xcode 26. Since 28 April 2026, apps uploaded to App Store Connect must be built with Xcode 26 or later using the iOS 26 SDK.",
      "sources": [
        {
          "title": "Apple: Upcoming Requirements",
          "url": "https://developer.apple.com/news/upcoming-requirements/"
        },
        {
          "title": "Apple Developer News: Upcoming SDK minimum requirements (3 February 2026)",
          "url": "https://developer.apple.com/news/?id=ueeok6yw"
        }
      ],
      "fixes": {
        "ci": {
          "title": "Build with Xcode 26 or later",
          "steps": [
            "Change the pinned version to Xcode 26 or later (27.1 is the current release) in the file and line the finding names, and use a runner or build image that has it.",
            "Fix the build warnings and errors the newer SDK reports before the next upload."
          ],
          "guide": "docs/guides/xcode-and-ios-minimums.md"
        }
      }
    },
    {
      "id": "RVW602",
      "severity": "error",
      "title": "Deployment target below iOS 13",
      "summary": "The app's iOS deployment target is lower than iOS 13. Since 9 September 2026, iOS and iPadOS apps uploaded to App Store Connect must target iOS 13 or later.",
      "sources": [
        {
          "title": "Apple: Upcoming Requirements",
          "url": "https://developer.apple.com/news/upcoming-requirements/"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Raise the deployment target",
          "steps": [
            "Set IPHONEOS_DEPLOYMENT_TARGET of the app target to 13.0 or later (target > General > Minimum Deployments in Xcode), and raise platform :ios in the Podfile to match.",
            "Remove the code paths that only ran on older iOS versions."
          ],
          "guide": "docs/guides/xcode-and-ios-minimums.md"
        },
        "expo-config": {
          "title": "Raise the deployment target",
          "steps": [
            "Set ios.deploymentTarget of the expo-build-properties plugin to 13.0 or later, or remove it to use the Expo SDK's default."
          ],
          "guide": "docs/guides/xcode-and-ios-minimums.md"
        }
      }
    },
    {
      "id": "RVW701",
      "severity": "warning",
      "title": "No privacy manifest",
      "summary": "The app has no PrivacyInfo.xcprivacy. Apple asks every app to record the data it collects in its privacy manifest, and since 1 May 2024 App Store Connect does not accept apps that use a required reason API (such as UserDefaults or file timestamps) without describing the reason in the app's privacy manifest.",
      "sources": [
        {
          "title": "Apple: Privacy manifest files",
          "url": "https://developer.apple.com/documentation/bundleresources/privacy-manifest-files"
        },
        {
          "title": "Apple: Describing use of required reason API",
          "url": "https://developer.apple.com/documentation/bundleresources/describing-use-of-required-reason-api"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Add a privacy manifest to the app target",
          "steps": [
            "In Xcode choose File > New > File from Template, pick App Privacy, name it PrivacyInfo.xcprivacy and tick the app target.",
            "Record the data the app collects (NSPrivacyCollectedDataTypes) and the reasons for each required reason API the app's own code uses (NSPrivacyAccessedAPITypes). SDKs ship their own manifests."
          ],
          "guide": "docs/guides/privacy-manifest.md"
        },
        "expo-config": {
          "title": "Add ios.privacyManifests to app.json",
          "steps": [
            "Add expo.ios.privacyManifests with NSPrivacyAccessedAPITypes (and the data types the app collects); prebuild writes them into PrivacyInfo.xcprivacy."
          ],
          "guide": "docs/guides/privacy-manifest.md"
        }
      }
    },
    {
      "id": "RVW702",
      "severity": "warning",
      "title": "Privacy manifest not in the app",
      "summary": "A PrivacyInfo.xcprivacy file is in the iOS folder, but no app target copies it into the app, so the uploaded app has no privacy manifest.",
      "sources": [
        {
          "title": "Apple: Privacy manifest files",
          "url": "https://developer.apple.com/documentation/bundleresources/privacy-manifest-files"
        }
      ],
      "fixes": {
        "info-plist": {
          "title": "Add the file to the app target",
          "steps": [
            "Select PrivacyInfo.xcprivacy in Xcode, open the File inspector and tick the app target under Target Membership, so it appears in Build Phases > Copy Bundle Resources."
          ],
          "guide": "docs/guides/privacy-manifest.md"
        }
      }
    }
  ],
  "purposeKeys": {
    "NSCameraUsageDescription": "camera",
    "NSMicrophoneUsageDescription": "microphone",
    "NSPhotoLibraryUsageDescription": "photo library",
    "NSPhotoLibraryAddUsageDescription": "adding to the photo library",
    "NSLocationWhenInUseUsageDescription": "location while the app is in use",
    "NSLocationAlwaysAndWhenInUseUsageDescription": "location at all times",
    "NSLocationAlwaysUsageDescription": "location at all times (before iOS 11)",
    "NSLocationUsageDescription": "location (macOS)",
    "NSContactsUsageDescription": "contacts",
    "NSCalendarsUsageDescription": "calendars (before iOS 17)",
    "NSCalendarsFullAccessUsageDescription": "calendars",
    "NSCalendarsWriteOnlyAccessUsageDescription": "adding calendar events",
    "NSRemindersUsageDescription": "reminders (before iOS 17)",
    "NSRemindersFullAccessUsageDescription": "reminders",
    "NSBluetoothAlwaysUsageDescription": "Bluetooth",
    "NSBluetoothPeripheralUsageDescription": "Bluetooth (before iOS 13)",
    "NSFaceIDUsageDescription": "Face ID",
    "NSSpeechRecognitionUsageDescription": "speech recognition",
    "NSUserTrackingUsageDescription": "App Tracking Transparency",
    "NSMotionUsageDescription": "motion and fitness data",
    "NSHealthShareUsageDescription": "reading health data",
    "NSHealthUpdateUsageDescription": "writing health data",
    "NSHealthClinicalHealthRecordsShareUsageDescription": "clinical health records",
    "NFCReaderUsageDescription": "NFC",
    "NSHomeKitUsageDescription": "HomeKit",
    "NSAppleMusicUsageDescription": "the media library",
    "NSLocalNetworkUsageDescription": "the local network",
    "NSSiriUsageDescription": "Siri"
  },
  "nativeApis": [
    {
      "label": "AVCaptureSession",
      "pattern": "\\bAVCaptureSession\\b|\\bAVCaptureDeviceInput\\b|\\bAVCaptureDevice\\s*\\.\\s*requestAccess\\s*\\(\\s*for\\s*:\\s*\\.video\\b|\\[\\s*AVCaptureDevice\\s+requestAccessForMediaType\\s*:\\s*AVMediaTypeVideo\\b",
      "keys": ["NSCameraUsageDescription"]
    },
    {
      "label": "DataScannerViewController",
      "pattern": "\\bDataScannerViewController\\b",
      "keys": ["NSCameraUsageDescription"]
    },
    {
      "label": "UIImagePickerController camera",
      "pattern": "sourceType\\s*=\\s*\\.camera\\b|UIImagePickerControllerSourceTypeCamera\\b",
      "keys": ["NSCameraUsageDescription"]
    },
    {
      "label": "microphone recording",
      "pattern": "\\bAVAudioRecorder\\b|\\brequestRecordPermission\\b|\\bAVCaptureDevice\\s*\\.\\s*requestAccess\\s*\\(\\s*for\\s*:\\s*\\.audio\\b|requestAccessForMediaType\\s*:\\s*AVMediaTypeAudio\\b",
      "keys": ["NSMicrophoneUsageDescription"]
    },
    {
      "label": "PHPhotoLibrary add-only access",
      "pattern": "\\bPHPhotoLibrary\\s*\\.\\s*requestAuthorization\\s*\\(\\s*for\\s*:\\s*\\.addOnly\\b|\\bUIImageWriteToSavedPhotosAlbum\\b|\\bUISaveVideoAtPathToSavedPhotosAlbum\\b|PHAccessLevelAddOnly\\b",
      "keys": ["NSPhotoLibraryAddUsageDescription"]
    },
    {
      "label": "PHPhotoLibrary access",
      "pattern": "\\bPHPhotoLibrary\\s*\\.\\s*requestAuthorization\\s*(\\(\\s*for\\s*:\\s*\\.readWrite\\b|\\{|\\(\\s*\\{|\\(\\s*\\))|\\[\\s*PHPhotoLibrary\\s+requestAuthorization\\s*:|\\bPHAsset\\s*\\.\\s*fetchAssets\\b|\\[\\s*PHAsset\\s+fetchAssets",
      "keys": ["NSPhotoLibraryUsageDescription"]
    },
    {
      "label": "CLLocationManager when-in-use",
      "pattern": "\\brequestWhenInUseAuthorization\\b",
      "keys": ["NSLocationWhenInUseUsageDescription"]
    },
    {
      "label": "CLLocationManager always",
      "pattern": "\\brequestAlwaysAuthorization\\b",
      "keys": ["NSLocationAlwaysAndWhenInUseUsageDescription"]
    },
    {
      "label": "CNContactStore",
      "pattern": "\\bCNContactStore\\b",
      "keys": ["NSContactsUsageDescription"]
    },
    {
      "label": "EKEventStore full access to events",
      "pattern": "\\brequestFullAccessToEvents\\b|\\brequestAccess\\s*\\(\\s*to\\s*:\\s*\\.event\\b|requestAccessToEntityType\\s*:\\s*EKEntityTypeEvent\\b",
      "keys": ["NSCalendarsFullAccessUsageDescription"]
    },
    {
      "label": "EKEventStore write-only access",
      "pattern": "\\brequestWriteOnlyAccessToEvents\\b",
      "keys": ["NSCalendarsWriteOnlyAccessUsageDescription"]
    },
    {
      "label": "EKEventStore reminders",
      "pattern": "\\brequestFullAccessToReminders\\b|\\brequestAccess\\s*\\(\\s*to\\s*:\\s*\\.reminder\\b|requestAccessToEntityType\\s*:\\s*EKEntityTypeReminder\\b",
      "keys": ["NSRemindersFullAccessUsageDescription"]
    },
    {
      "label": "Core Bluetooth",
      "pattern": "\\bCBCentralManager\\b|\\bCBPeripheralManager\\b",
      "keys": ["NSBluetoothAlwaysUsageDescription"]
    },
    {
      "label": "LAContext evaluatePolicy",
      "pattern": "\\bevaluatePolicy\\s*(\\(|:)",
      "keys": ["NSFaceIDUsageDescription"]
    },
    {
      "label": "SFSpeechRecognizer",
      "pattern": "\\bSFSpeechRecognizer\\s*(\\.\\s*|\\s+)requestAuthorization\\b",
      "keys": ["NSSpeechRecognitionUsageDescription"]
    },
    {
      "label": "ATTrackingManager",
      "pattern": "\\bATTrackingManager\\s*(\\.\\s*|\\s+)requestTrackingAuthorization",
      "keys": ["NSUserTrackingUsageDescription"]
    },
    {
      "label": "Core Motion",
