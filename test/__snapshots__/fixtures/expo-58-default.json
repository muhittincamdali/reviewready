      "severity": "warning",
      "title": "Export compliance not declared",
      "message": "app.json sets neither ios.config.usesNonExemptEncryption nor ios.infoPlist.ITSAppUsesNonExemptEncryption, so App Store Connect asks the export compliance questions for every build.",
      "file": "app.json",
      "line": null,
      "target": "hello-world",
      "fix": {
        "id": "RVW201/expo-config",
        "title": "Declare the app's encryption in app.json",
        "steps": [
          "Set expo.ios.config.usesNonExemptEncryption to false if the app uses no encryption or only exempt encryption such as HTTPS, or to true and follow Apple's documentation otherwise."
        ],
        "guide": "https://github.com/muhittincamdali/reviewready/blob/main/docs/guides/export-compliance.md"
      },
      "sources": [
        {
          "title": "Apple: ITSAppUsesNonExemptEncryption",
          "url": "https://developer.apple.com/documentation/bundleresources/information-property-list/itsappusesnonexemptencryption"
        },
        {
          "title": "Apple: Complying with Encryption Export Regulations",
          "url": "https://developer.apple.com/documentation/security/complying-with-encryption-export-regulations"
        }
      ]
    },
    {
      "rule": "RVW701",
      "severity": "warning",
      "title": "No privacy manifest",
      "message": "app.json has no ios.privacyManifests, so prebuild writes no privacy manifest for the app.",
      "file": "app.json",
      "line": null,
      "target": "hello-world",
      "fix": {
        "id": "RVW701/expo-config",
        "title": "Add ios.privacyManifests to app.json",
        "steps": [
          "Add expo.ios.privacyManifests with NSPrivacyAccessedAPITypes (and the data types the app collects); prebuild writes them into PrivacyInfo.xcprivacy."
        ],
        "guide": "https://github.com/muhittincamdali/reviewready/blob/main/docs/guides/privacy-manifest.md"
      },
      "sources": [
        {
          "title": "Apple: Privacy manifest files",
